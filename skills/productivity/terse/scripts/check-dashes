#!/usr/bin/env python3
"""Exit 1 if the text contains an em dash (U+2014) or en dash (U+2013)."""

import sys

BANNED = {"\u2014": "em dash", "\u2013": "en dash"}


def main() -> None:
    if len(sys.argv) > 1:
        with open(sys.argv[1], encoding="utf-8") as handle:
            text = handle.read()
    else:
        text = sys.stdin.read()
    hits = []
    for number, line in enumerate(text.splitlines(), 1):
        found = [name for char, name in BANNED.items() if char in line]
        if found:
            hits.append(f"{number}: {', '.join(found)}")
    if hits:
        print("\n".join(hits), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
