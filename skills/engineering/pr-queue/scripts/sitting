#!/usr/bin/env python3
"""The sitting commands: open, strike, brief, checkout, and walk.

    sitting open --session KEY --root PATH --stepper PATH --viewer LOGIN [--all]
                 [--started EPOCH] [--aliases PATH] < issues

Applies the lease rules to the pr-queue context, fetches a fresh queue with
pr-queue only when none is left in place, then prints the queue and the four
brief parts. The In Review issues arrive on stdin in the format pr-queue reads.
This command does not search Jira.

    sitting checkout --session KEY --root PATH --stepper PATH [--aliases PATH]

Resolves the active pr-queue item to its local clone, leaves that clone on the
pull request head, and prints the clone path and the pull request's base ref.

    sitting strike --session KEY --root PATH --stepper PATH --evidence TEXT

Verifies the active pr-queue item with the evidence given, then prints the next
item's four brief parts from stepper's --brief form.

    sitting brief --session KEY --root PATH --stepper PATH

Prints the four brief parts for this chat's sitting. Changes nothing.

    sitting walk --session KEY --root PATH --stepper PATH --viewer LOGIN
                 [--qpre CMD] [--outcome-dir DIR] [--keys FILE]

Walks the sitting in the terminal. For the active item it prints the brief, runs
qpre on the item's pull request with the terminal inherited, reads the one
outcome line qpre wrote, and speaks posted, clean, or unfinished (a missing line
is "missing outcome"). It also says whether --viewer approved the latest commit.
Then one key: s strikes and walks the next, k keeps it active, q or Ctrl-C
leaves the walk. Quitting qpre leaves the item active with no strike prompt.
--qpre (env SITTING_QPRE, default qpre), --outcome-dir (env SITTING_OUTCOME_DIR,
default ~/.qpr/outcomes), and --keys (a file of keys instead of the terminal)
are seams for tests.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import termios
import tty
from pathlib import Path

if sys.version_info < (3, 11):
    sys.stderr.write(
        "sitting needs Python 3.11 or newer; found %s at %s.\n"
        % (sys.version.split()[0], sys.executable)
    )
    raise SystemExit(3)

sys.path.insert(0, str(Path(__file__).resolve().parent))

import aliases_yaml  # noqa: E402

CONTEXT = "pr-queue"
PROMPT = "s strike, k keep active, q quit: "
URL = re.compile(r"https://github\.com/[^/\s]+/[^/\s]+/pull/\d+")
PARTS = re.compile(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)")


def stop(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def expand(path: str) -> str:
    candidate = Path(path).expanduser()
    if not candidate.is_absolute():
        candidate = Path.cwd() / candidate
    return os.path.normpath(str(candidate))


def as_list(value):
    if value is None:
        return []
    if isinstance(value, list):
        return value
    return [value]


def dig(obj, *keys):
    for key in keys:
        if not isinstance(obj, dict):
            return None
        obj = obj.get(key)
    return obj


def run(args: list, cwd: str | None = None) -> str:
    proc = subprocess.run(args, cwd=cwd, text=True, capture_output=True, encoding="utf-8")
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip()
        stop(f"{' '.join(args[:3])}: {detail}")
    return proc.stdout


def stepper(options, *args):
    return json.loads(run(["python3", options.stepper, *args]))


def scope(options) -> list:
    return ["--session", options.session, "--root", options.root]


def require(options, *keys: str) -> None:
    for key in keys:
        if not getattr(options, key):
            stop(f"pass --{key}")


def sitting_status(options):
    return stepper(options, "status", *scope(options), "--context", CONTEXT)


def print_brief(brief) -> None:
    brief = brief or {}
    for part in ("done", "left", "blocked"):
        values = as_list(brief.get(part))
        print(f"{part}: {', '.join(values) if values else 'none'}")
    position = brief.get("position")
    print(f"position: {'' if position is None else position}")


def open_sitting(options) -> None:
    require(options, "session", "root", "stepper")
    listed = stepper(options, "status", "--root", options.root)
    found = next(
        (context for context in as_list(listed.get("contexts")) if context.get("id") == CONTEXT and not context.get("closed")),
        None,
    )
    holder = dig(found, "lease", "session_key") if found else None
    if holder and holder != options.session:
        stop(f"the {CONTEXT} sitting is held by {holder}; ask that chat to finish or release it")

    attach = ["attach", *scope(options), "--context", CONTEXT, "--brief"]
    if found and not found.get("complete"):
        if not holder:
            stepper(options, *attach)
        sitting = dig(sitting_status(options), "context", "items")
        for entry in as_list(sitting):
            if entry.get("status") not in ("verified", "cancelled"):
                print(entry.get("description"))
    else:
        if found:
            if not holder:
                stepper(options, *attach)
            stepper(options, "close", *scope(options), "--context", CONTEXT, "--brief")
        fetch_queue(options)

    held = any(
        context.get("id") == CONTEXT and not context.get("closed")
        for context in as_list(stepper(options, "status", "--root", options.root).get("contexts"))
    )
    if held:
        print_brief(stepper(options, *attach).get("brief"))
    else:
        print_brief({"done": [], "left": [], "blocked": [], "position": "none"})


def strike(options) -> None:
    require(options, "session", "root", "stepper")
    if not str(options.evidence or "").strip():
        stop("pass --evidence")
    items = as_list(dig(sitting_status(options), "context", "items"))
    active = next((entry for entry in items if entry.get("status") == "active"), None)
    if active is None:
        stop("no active item in the sitting")
    print_brief(stepper(
        options, "verify", *scope(options), "--context", CONTEXT, active["id"],
        "--evidence", options.evidence, "--brief",
    ).get("brief"))


def brief(options) -> None:
    require(options, "session", "root", "stepper")
    print_brief(sitting_status(options).get("brief"))


def key_reader(options):
    if options.keys:
        handle = open(options.keys, encoding="utf-8")

        def read_file():
            char = handle.read(1)
            return char or None

        return read_file

    if sys.stdin.isatty():
        stream = sys.stdin
    else:
        try:
            stream = open("/dev/tty", encoding="utf-8")
        except OSError:
            stop("walk needs a terminal; there is none")

    def read_tty():
        fd = stream.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            char = stream.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        return char or None

    return read_tty


def outcome_word(path: Path) -> str:
    if path.is_file():
        text = path.read_text(encoding="utf-8")
        line = text.splitlines()[0].strip() if text else ""
    else:
        line = ""
    if re.match(r"posted\b", line):
        return "posted"
    if line == "clean":
        return "clean"
    if re.match(r"(partial|unfinished|unposted)\b", line):
        return "unfinished"
    return "missing outcome"


def approved_on_head(url: str, viewer: str) -> bool:
    org, repo, number = PARTS.search(url).groups()
    pr = json.loads(run(["gh", "pr", "view", number, "--repo", f"{org}/{repo}", "--json", "headRefOid,reviews"]))
    return any(
        review.get("state") == "APPROVED"
        and dig(review, "author", "login") == viewer
        and dig(review, "commit", "oid") == pr.get("headRefOid")
        for review in as_list(pr.get("reviews"))
    )


def active_item(options):
    return next(
        (entry for entry in as_list(dig(sitting_status(options), "context", "items")) if entry.get("status") == "active"),
        None,
    )


def walk(options) -> None:
    require(options, "session", "root", "stepper", "viewer")
    next_key = key_reader(options)
    qpre = options.qpre or os.environ.get("SITTING_QPRE") or "qpre"
    outcomes = Path(options.outcome_dir or os.environ.get("SITTING_OUTCOME_DIR") or "~/.qpr/outcomes").expanduser()
    active = active_item(options)
    if active is None:
        stop("no active item in the sitting")
    print_brief(sitting_status(options).get("brief"))

    while active:
        url = URL.search(str(active.get("completion_criteria") or ""))
        if not url:
            stop(f"active item {active['id']} names no pull request url")
        url = url.group(0)
        org, repo, number = PARTS.search(url).groups()
        path = outcomes / f"{org}-{repo}-{number}"
        if path.is_file():
            path.unlink()

        sys.stdout.flush()
        try:
            ran = subprocess.run([qpre, url])
            ok = ran.returncode == 0
        except OSError:
            ok = False
        if not ok:
            print(f"qpre quit; {active['id']} stays active")
            return

        outcome = outcome_word(path)
        approved = approved_on_head(url, options.viewer)
        print(f"outcome: {outcome}")
        print(f"approved: {'yes' if approved else 'no'}")

        choice = None
        while not choice:
            print(PROMPT, end="")
            sys.stdout.flush()
            key = next_key()
            print()
            if key in ("s", "k"):
                choice = key
            elif key in (None, "q", "\u0003"):
                choice = "q"
        if choice != "s":
            print(f"{active['id']} stays active")
            return

        options.evidence = f"{outcome}; {'approved' if approved else 'not approved'} on latest commit; struck in walk"
        strike(options)
        active = active_item(options)
    print("no active item; the walk is done")


def fetch_queue(options) -> None:
    if not options.viewer:
        stop("pass --viewer")
    command = [
        sys.executable, str(Path(__file__).resolve().parent / "pr-queue"),
        "--viewer", options.viewer, *scope(options),
        "--stepper", options.stepper, "--aliases", options.aliases,
    ]
    if options.all:
        command.append("--all")
    if options.started:
        command.extend(["--started", options.started])
    if options.fixture:
        command.extend(["--github-fixture", options.fixture])
    if options.today:
        command.extend(["--today", options.today])
    incoming = "" if sys.stdin.isatty() else sys.stdin.read()
    proc = subprocess.run(command, input=incoming, text=True, capture_output=True, encoding="utf-8")
    if proc.returncode != 0:
        stop(proc.stderr.strip())
    kept = "".join(line for line in proc.stderr.splitlines(keepends=True) if not line.startswith("pr-queue brief"))
    if not kept.endswith("\n"):
        kept += "\n"
    sys.stderr.write(kept)
    sys.stdout.write(proc.stdout)


def checkout(options) -> None:
    require(options, "session", "root", "stepper")
    try:
        data = aliases_yaml.load(options.aliases)
    except OSError as error:
        stop(str(error))
    team = next(
        (
            value for value in data.values()
            if isinstance(value, dict) and value.get("type") == "team" and "my team" in as_list(value.get("aliases"))
        ),
        None,
    )
    if team is None:
        stop(f"missing team aliased my team in {options.aliases}")
    roots = [expand(path) for path in as_list(team.get("clone_roots"))]
    if not roots:
        stop(f"missing clone_roots on the team record in {options.aliases}; add a line `clone_roots: [~/src/work]` under it")

    items = as_list(dig(sitting_status(options), "context", "items"))
    active = next((item for item in items if item.get("status") == "active"), None)
    if active is None:
        stop("no active item in the sitting")
    found = URL.search(str(active.get("completion_criteria") or ""))
    if not found:
        stop(f"active item {active['id']} names no pull request url")
    org, repo, number = PARTS.search(found.group(0)).groups()

    clone = next((str(Path(root) / repo) for root in roots if (Path(root) / repo / ".git").is_dir()), None)
    if clone is None:
        stop(f"no clone of {repo} under {', '.join(roots)}")
    dirty = run(["git", "status", "--porcelain"], cwd=clone)
    if dirty.strip():
        stop(f"{clone} has uncommitted changes; commit or stash them first")

    pr = json.loads(run(["gh", "pr", "view", number, "--repo", f"{org}/{repo}", "--json", "headRefName,headRefOid,baseRefName"]))
    run(["git", "fetch", "origin", f"refs/pull/{number}/head"], cwd=clone)
    fetched = run(["git", "rev-parse", "FETCH_HEAD"], cwd=clone).strip()
    if fetched != pr.get("headRefOid"):
        stop(f"fetched {fetched} but the pull request head is {pr.get('headRefOid')}")
    run(["git", "checkout", "-B", pr["headRefName"], fetched], cwd=clone)
    print(f"clone: {clone}")
    print(f"base: {pr.get('baseRefName')}")


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1].startswith("-"):
        stop("usage: sitting open|strike|brief|checkout|walk --session KEY --root PATH --stepper PATH")
    command = sys.argv[1]
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--session")
    parser.add_argument("--root")
    parser.add_argument("--stepper")
    parser.add_argument("--aliases", default=str(Path.home() / ".claude" / "aliases.yaml"))
    parser.add_argument("--evidence")
    parser.add_argument("--viewer")
    parser.add_argument("--qpre")
    parser.add_argument("--outcome-dir")
    parser.add_argument("--keys")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--started")
    parser.add_argument("--github-fixture", dest="fixture")
    parser.add_argument("--today")
    options = parser.parse_args(sys.argv[2:])
    commands = {
        "open": open_sitting,
        "strike": strike,
        "brief": brief,
        "checkout": checkout,
        "walk": walk,
    }
    if command not in commands:
        stop("usage: sitting open|strike|brief|checkout|walk --session KEY --root PATH --stepper PATH")
    commands[command](options)


if __name__ == "__main__":
    main()
